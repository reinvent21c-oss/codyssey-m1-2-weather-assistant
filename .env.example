# Use the actual Firebase project ID, not the project display name.
FIREBASE_PROJECT_ID=

# Choose one source. Nonempty JSON takes priority over the path.
# Leave credentials empty in this example; never commit real values.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Comma-separated explicit browser origins; empty means no cross-origin access.
# Example for future local UI: http://localhost:5173
ALLOWED_ORIGINS=

# Backend only. Never expose the key to a browser or commit real values.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
OPENAI_MODEL=gpt-5.4-mini

# Required for every /api request. Set privately on the backend; never commit it.
EVALUATION_ACCESS_CODE=
ADMIN_ACCESS_CODE=
GPT_RATE_LIMIT_REQUESTS=
GPT_RATE_LIMIT_WINDOW_SECONDS=
